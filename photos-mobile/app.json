{
  "expo": {
    "name": "Starkeep Photos",
    "slug": "starkeep-photos",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "app.starkeep.photos",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png",
        "backgroundColor": "#0a0818",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-file-system",
      "expo-image",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Starkeep uses the camera to scan the pairing code from admin-web.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Starkeep shows the photos and videos already on this device.",
          "savePhotosPermission": "Starkeep saves photos back to your device library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ]
    ]
  }
}
