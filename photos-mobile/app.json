{
  "expo": {
    "name": "Starkeep Photos",
    "slug": "starkeep-photos",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "app.starkeep.photos",
      "allowBackup": false,
      "permissions": ["READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "CAMERA"]
    },
    "plugins": [
      "expo-file-system",
      "expo-image",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Starkeep uses the camera to scan the pairing code from admin-web.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Starkeep shows the photos and videos already on this device.",
          "savePhotosPermission": "Starkeep saves photos back to your device library.",
          "granularPermissions": ["photo", "video"]
        }
      ]
    ]
  }
}
