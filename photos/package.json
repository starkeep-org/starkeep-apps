{
  "name": "photos-web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm vision:build-worker && next dev",
    "build": "open-next build",
    "bundle": "tsx infra/build-bundle.ts",
    "start": "pnpm vision:build-worker && next start",
    "vision:fetch-models": "tsx scripts/fetch-vision-models.ts",
    "vision:fetch-fixtures": "tsx scripts/fetch-vision-fixtures.ts",
    "vision:build-worker": "tsx scripts/build-vision-worker.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1031.0",
    "@starkeep/app-client": "^0.3.2",
    "exifr": "^7.1.3",
    "next": "^16.0.0",
    "onnxruntime-node": "^1.27.0",
    "open-next": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@starkeep/e2e": "link:../../starkeep-core/e2e",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
